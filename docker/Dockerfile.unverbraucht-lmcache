# Build LMCache (HIP) on top of the unverbraucht vLLM GFX906 image.
# Produces a single image that serves both roles:
#   - vLLM with the LMCacheMPConnector importable inside the engine
#   - `lmcache server` (standalone MP-mode cache server)
#
# This Dockerfile is base-agnostic across the unverbraucht line — pass the
# base via --build-arg BASE_IMAGE (the build script does this for you):
#   - unverbraucht/vllm-gfx906:0.26.0-rocm-7.2.1   (torch 2.11.0a0, ROCm 7.2.1)
#   - unverbraucht/vllm-gfx906:0.28.0rc2-rocm-7.14 (torch 2.13.0,  ROCm 7.14)
# LMCache is built from source against the base's torch, so the same Dockerfile
# works for every unverbraucht ROCm build; only the base changes.
#
# Deltas vs Dockerfile.mobydick-lmcache (mobydick base):
#   - LMCache source must be a recent dev build; the native module was RENAMED
#     from lmcache.c_ops to lmcache.cuda_ops / lmcache.lmcache_native in the
#     0.26.0-era wheel (lmcache 0.1.dev67). The final verify step reflects that.
#   - cufile-python is NOT in the base, so its removal is best-effort.
#   - cupy: only cupy-rocm-7-0 exists on PyPI (no cupy-rocm-7-1), so the same
#     wheel is used across ROCm 7.x bases; it is the ROCm 7.x line.
#
# NOTE: LMCache dev currently requires torch==2.13.0 for its build; the
# 0.28.0rc2 base ships exactly torch 2.13.0+gfx906, so the two line up. If you
# build against an older base (e.g. 0.26.0 / torch 2.11.0a0), the in-image
# torch is used for the extension build and the torch pin in LMCache's
# build-system is not enforced (no build isolation).
#
# The LMCache source must be in the build context as ./LMCache
# (git clone https://github.com/LMCache/LMCache.git LMCache).
#
# Build (the build script does this for you — see build_lmcache_docker.sh):
#   BASE_IMAGE=unverbraucht/vllm-gfx906:0.28.0rc2-rocm-7.14 ./build_lmcache_docker.sh
#   # -> vllm-gfx906-lmcache:0.28.0rc2
#   (or by hand: docker build -t vllm-gfx906-lmcache:0.28.0rc2 \
#       --build-arg BASE_IMAGE=unverbraucht/vllm-gfx906:0.28.0rc2-rocm-7.14 \
#       -f docker/Dockerfile.unverbraucht-lmcache .)
#
# Validated on: MI50 (gfx906), unverbraucht 0.28.0rc2 / torch 2.13.0 /
# ROCm 7.14, LMCache dev (v0.5.4 era), Qwen3.6-27B.

# syntax=docker/dockerfile:1.4
ARG BASE_IMAGE=unverbraucht/vllm-gfx906:0.26.0-rocm-7.2.1
FROM ${BASE_IMAGE} AS builder

# Build deps (base already ships git/cmake/hipcc; keep for safety)
RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake ninja-build pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
RUN pip install uv

# Copy LMCache source (from the build context)
COPY LMCache /workspace/LMCache
WORKDIR /workspace/LMCache

# Install build requirements
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install ninja packaging 'setuptools>=77.0.3,<81.0.0' 'setuptools_scm>=8' wheel

# Build LMCache wheel with HIP extensions matching the base ROCm / torch.
# BUILD_WITH_HIP=1 hipifies csrc/ and compiles with hipcc; the resulting
# native extensions ABI-match the torch inside the base image.
ENV BUILD_WITH_HIP=1
ENV CXX=hipcc
ENV PYTORCH_ROCM_ARCH=gfx906
ENV ROCM_PATH=/opt/rocm

RUN --mount=type=cache,target=/root/.cache/pip \
    python3 setup.py bdist_wheel --dist-dir=/dist_lmcache

# Verify the wheel was built
RUN ls -la /dist_lmcache/*.whl

# ─── Final stage: install into a clean copy of the base image ─────────────

FROM ${BASE_IMAGE} AS final

# Copy the built wheel
COPY --from=builder /dist_lmcache/ /tmp/dist_lmcache/

# CuPy for ROCm 7.x — LMCache's GPU cache context uses cupy.cuda streams
# for CUDA-IPC reconstruction and host-func dispatch.
RUN pip install cupy-rocm-7-0

# Install LMCache wheel, then fix dependency conflicts:
# 1. cufile-python is NVIDIA-only (pulled in by some lmcache dep sets); on
#    ROCm the GDS path routes to hipFile at runtime. Not in this base image,
#    so removal is best-effort.
# 2. LMCache's deps bump grpcio past vLLM's pin; restore it.
RUN pip install /tmp/dist_lmcache/*.whl && rm -rf /tmp/dist_lmcache && \
    (pip uninstall -y cufile-python || true) && \
    pip install 'grpcio==1.78.0'

# Verify both the Python package and the HIP extension import.
# NOTE: in the 0.26.0-era wheel the native module is lmcache.cuda_ops +
# lmcache.lmcache_native — lmcache.c_ops no longer exists.
RUN python3 -c "import lmcache; import lmcache.cuda_ops, lmcache.lmcache_native; print('LMCache + HIP native OK')"

WORKDIR /workspace
CMD ["/bin/bash"]